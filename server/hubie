#!/usr/bin/env bash
# Short commands for running Hubie from a phone.
set -euo pipefail
H=/opt/hubie
ENVF=/etc/hubie.env

case "${1:-help}" in
  secrets)
    bash "$H/server/secrets.sh" ;;

  update)
    git -C "$H" pull --ff-only
    (cd "$H/server" && npm install --omit=dev --no-audit --no-fund)
    chmod +x "$H/server/hubie" "$H/server/"*.sh; chown -R hubie:hubie "$H"
    systemctl restart hubie-brain 2>/dev/null || true
    echo "UPDATE-OK" ;;

  test-login)
    dir="$H/shots/$(date +%m%d-%H%M)"; mkdir -p "$dir"; chown hubie:hubie "$dir"
    runuser -u hubie -- bash -c "set -a; . $ENVF; set +a; export SHOTS_DIR='$dir'; cd $H/server && \
      xvfb-run -a -s '-screen 0 1280x720x24' node test_login.js"
    echo; echo "Screenshots saved. To see them: hubie shots" ;;

  test-stream)
    mins="${2:-6}"
    systemctl stop hubie-test 2>/dev/null || true
    systemd-run --quiet --unit=hubie-test --collect -p User=hubie -p WorkingDirectory="$H/server" \
      -p Environment=HOME=/home/hubie bash "$H/server/stream_test.sh" "$mins"
    echo "Stream test started for $mins min. Watch kick.com/iamhubie"
    echo "Live log: hubie log   (ctrl+c just closes the log, the test keeps running)" ;;

  log)
    journalctl -u hubie-test -f -n 40 -o cat ;;

  stop)
    systemctl stop hubie-test 2>/dev/null || true; echo "stopped" ;;

  shots)
    bash "$H/server/shots.sh" ;;

  voices)
    bash "$H/server/voices.sh"; systemctl restart hubie-brain 2>/dev/null || true ;;

  kick-login)
    host=$(head -1 /etc/caddy/Caddyfile 2>/dev/null | tr -d ' {')
    if ! curl -fs http://127.0.0.1:8090/health >/dev/null || [ -z "$host" ]; then echo "Brain not running. Re-run the setup line."; exit 1; fi
    echo "Open this in Chrome on your phone (logged in to Kick as Iamhubie):"
    echo "  https://$host/kick/login?k=$(cat $H/data/login-token)" ;;

  brain-log)
    journalctl -u hubie-brain -f -n 40 -o cat ;;

  status)
    curl -fs http://127.0.0.1:8090/health | python3 -m json.tool || echo "brain not running" ;;

  chat)   # hubie chat <name> <message...>  -> pretend a viewer typed it
    n="${2:-tester}"; shift; shift || true
    curl -fs -G http://127.0.0.1:8090/test/chat --data-urlencode "name=$n" --data-urlencode "text=${*:-hi hubie}" && echo " sent" ;;

  follow)
    curl -fs -G http://127.0.0.1:8090/test/follow --data-urlencode "name=${2:-tester}" && echo " sent" ;;

  *)
    echo "hubie secrets | voices | kick-login | status | brain-log | chat <name> <msg> | follow <name> | test-login | test-stream [minutes] | log | stop | shots | update" ;;
esac
