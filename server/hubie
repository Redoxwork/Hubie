#!/usr/bin/env bash
# Short commands for running Hubie from a phone.
set -euo pipefail
H=/opt/hubie
ENVF=/etc/hubie.env

case "${1:-help}" in
  secrets)
    bash "$H/server/secrets.sh" ;;

  update)
    git -C "$H" fetch -q origin main && git -C "$H" reset -q --hard origin/main
    (cd "$H/server" && npm install --omit=dev --no-audit --no-fund)
    chmod +x "$H/server/hubie" "$H/server/"*.sh; chown -R hubie:hubie "$H"
    cp "$H/server/hubie-brain.service" "$H/server/hubie-live.service" /etc/systemd/system/ && systemctl daemon-reload
    mkdir -p "$H/recordings" "$H/data"; chown -R hubie:hubie "$H"
    systemctl restart hubie-brain 2>/dev/null || true
    systemctl is-active --quiet hubie-live && echo "(live is running: restart it with 'hubie live' to use the new code)"
    echo "UPDATE-OK" ;;

  test-login)
    dir="$H/shots/$(date +%m%d-%H%M)"; mkdir -p "$dir"; chown hubie:hubie "$dir"
    runuser -u hubie -- bash -c "set -a; . $ENVF; set +a; export SHOTS_DIR='$dir'; cd $H/server && \
      xvfb-run -a -s '-screen 0 1280x720x24' node test_login.js"
    echo; echo "Screenshots saved. To see them: hubie shots" ;;

  test-stream)
    mins="${2:-6}"
    systemctl stop hubie-test 2>/dev/null || true
    systemd-run --quiet --unit=hubie-test --collect -p User=hubie -p WorkingDirectory="$H/server" \
      -p Environment=HOME=/home/hubie bash "$H/server/stream_test.sh" "$mins"
    echo "Stream test started for $mins min. Watch kick.com/iamhubie"
    echo "Live log: hubie log   (ctrl+c just closes the log, the test keeps running)" ;;

  log)
    journalctl -u hubie-test -u hubie-live -f -n 40 -o cat ;;

  live)   # the real thing: non-stop stream that restarts itself (and survives reboots)
    systemctl stop hubie-test 2>/dev/null || true
    if systemctl is-active --quiet hubie-live || pgrep -f ffmpeg >/dev/null || pgrep -f live.sh >/dev/null; then
      systemctl stop hubie-live || true; pkill -f ffmpeg || true; pkill -f google-chrome || true; pkill -f Xvfb || true; pkill -f mediamtx || true
      touch "$H/data/fresh-session"; chown hubie:hubie "$H/data/fresh-session"   # the server waits 90 s itself
      echo "Restarting: offline for 90 s so Kick starts a fresh stream session (the server handles it, you can close Termius)."
    fi
    curl -fs http://127.0.0.1:8090/session/new >/dev/null 2>&1 || true
    systemctl start hubie-brain
    date +%s > "$H/data/live-since"; chown hubie:hubie "$H/data/live-since"
    systemctl enable --now hubie-live >/dev/null 2>&1 && systemctl restart hubie-live
    echo "Hubie is LIVE and will keep going by himself (even after a reboot)."
    echo "Watch: hubie log   ·   Stop: hubie stop" ;;

  stop)   # stop the stream (add "all" to also stop the brain)
    systemctl disable --now hubie-live >/dev/null 2>&1 || true
    systemctl stop hubie-test 2>/dev/null || true
    [ "${2:-}" = all ] && systemctl stop hubie-brain 2>/dev/null
    for p in stream_test.sh live.sh ffmpeg mediamtx google-chrome Xvfb keeper.js proxy.js; do pkill -f "$p" || true; done; sleep 1
    pgrep -f ffmpeg >/dev/null && echo "something is still running, try again" || echo "stopped (Kick can take a minute to show offline)" ;;

  proxy)   # hubie proxy <http://user:pass@host:port> | off | test
    setkey(){ grep -v "^$1=" "$ENVF" > "$ENVF.tmp" || true; [ -n "$2" ] && printf '%s=%q\n' "$1" "$2" >> "$ENVF.tmp"; mv "$ENVF.tmp" "$ENVF"; chown root:hubie "$ENVF"; chmod 640 "$ENVF"; }
    case "${2:-test}" in
      off) setkey HUBIE_PROXY ""; echo "Proxy removed. Run 'hubie live' to use it." ;;
      test) ;;
      *) setkey HUBIE_PROXY "$2"; echo "Proxy saved." ;;
    esac
    set -a; . "$ENVF"; set +a
    [ -z "${HUBIE_PROXY:-}" ] && { echo "No proxy set. Use: hubie proxy http://user:pass@host:port"; exit 0; }
    p="$HUBIE_PROXY"; case "$p" in *://*) ;; *) p="http://$p" ;; esac
    echo "Server IP:  $(curl -s --max-time 10 https://api.ipify.org)"
    echo "Proxy IP:   $(curl -s --max-time 20 -x "$p" https://api.ipify.org || echo FAILED)"
    echo "Proxy place: $(curl -s --max-time 20 -x "$p" https://ipinfo.io/json | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("city"), d.get("country"), "-", d.get("org"))' 2>/dev/null || echo unknown)"
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 -x "$p" -A 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36' https://www.housebets.com/)
    echo "Housebets via proxy: HTTP $code"
    echo "Next: hubie test-login   (then hubie shots to see if the security check is gone)" ;;

  archive)   # list the saved 480p hours of the run
    ls -lh /opt/hubie/archive 2>/dev/null | tail -n +2 | awk '{print $5, $9}'; echo; du -sh /opt/hubie/archive /opt/hubie/recordings 2>/dev/null; df -h /opt/hubie | tail -1 ;;

  report)   # how the run is going since the last 'hubie live'
    bash "$H/server/report.sh" ;;

  login-view)   # hubie login-view [stop] : log in by hand once through a private screen link
    shift; bash "$H/server/login_view.sh" "$@" ;;

  games)   # hubie games on|off  (originals + slots bot)
    v=0; [ "${2:-}" = on ] && v=1
    for k in GAMES SLOTS; do grep -v "^$k=" "$ENVF" > "$ENVF.tmp" || true; echo "$k=$v" >> "$ENVF.tmp"; mv "$ENVF.tmp" "$ENVF"; done
    chown root:hubie "$ENVF"; chmod 640 "$ENVF"; systemctl restart hubie-brain 2>/dev/null || true
    echo "Games $( [ $v = 1 ] && echo ON || echo OFF ). Run 'hubie live' to restart the stream with it." ;;

  shots)
    bash "$H/server/shots.sh" ;;

  voices)
    bash "$H/server/voices.sh"; systemctl restart hubie-brain 2>/dev/null || true ;;

  laughs)  # laugh samples to pick from (served on port 8080)
    out="$H/shots/laughs-$(date +%m%d-%H%M)"; mkdir -p "$out"
    "$H/tts/venv/bin/python" "$H/server/tts_samples.py" laughs "$H/tts" "$out" && chown -R hubie:hubie "$out" && bash "$H/server/shots.sh" ;;

  laugh-clips)   # hubie laugh-clips <sound page url> ... : fetch, cut, preview
    shift; mkdir -p "$H/tts/laughs/raw"; chown -R hubie:hubie "$H/tts/laughs"
    runuser -u hubie -- env HUBIE_DIR="$H" node "$H/server/laughs.js" "$@" && systemctl restart hubie-brain && bash "$H/server/shots.sh" ;;

  laugh-keep)    # hubie laugh-keep laugh1 chuckle3 : keep only these clips
    shift; cd "$H/tts/laughs" && for f in *.mp3; do keep=0; for k in "$@"; do [ "${f%.mp3}" = "$k" ] && keep=1; done; [ $keep = 1 ] || rm -f "$f"; done; ls *.mp3; systemctl restart hubie-brain ;;

  kick-login)
    host=$(head -1 /etc/caddy/Caddyfile 2>/dev/null | tr -d ' {')
    if ! curl -fs http://127.0.0.1:8090/health >/dev/null || [ -z "$host" ]; then echo "Brain not running. Re-run the setup line."; exit 1; fi
    echo "Open this in Chrome on your phone (logged in to Kick as Iamhubie):"
    echo "  https://$host/kick/login?k=$(cat $H/data/login-token)" ;;

  brain-log)
    journalctl -u hubie-brain -f -n 40 -o cat ;;

  status)
    curl -fs http://127.0.0.1:8090/health | python3 -m json.tool || echo "brain not running" ;;

  chat)   # hubie chat <name> <message...>  -> pretend a viewer typed it
    n="${2:-tester}"; shift; shift || true
    curl -fs -G http://127.0.0.1:8090/test/chat --data-urlencode "name=$n" --data-urlencode "text=${*:-hi hubie}" && echo " sent" ;;

  set-info)   # set the Kick stream title + category
    t="${2:-🦥 Hubie LIVE 24/7 | the Housebets sloth | chat games, demo play only | !commands}"
    curl -s -G http://127.0.0.1:8090/info --data-urlencode "title=$t" --data-urlencode "category=${3:-Slots & Casino}"; echo ;;

  game)   # hubie game guess|poll  -> start a chat game now
    curl -fs -G http://127.0.0.1:8090/test/game --data-urlencode "kind=${2:-guess}" && echo " started" ;;

  follow)
    curl -fs -G http://127.0.0.1:8090/test/follow --data-urlencode "name=${2:-tester}" && echo " sent" ;;

  *)
    echo "hubie live | report | archive | stop [all] | secrets | proxy <url>|off|test | login-view [stop] | games on|off | voices | laughs | laugh-clips <urls> | laugh-keep <names> | kick-login | status | brain-log | chat <name> <msg> | follow <name> | game guess|poll | set-info | test-login | test-stream [minutes] | log | stop | shots | update" ;;
esac
